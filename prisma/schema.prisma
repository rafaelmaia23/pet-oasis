generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  passwordHash  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  
  employee  Employee?
  customer  Customer?

  
  roles     UserRole[]
  features  UserFeature[]   // overrides por usuário (concede/nega)
}

model Employee {
  id      String   @id @default(uuid())
  userId  String   @unique
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  salary  Decimal?
  hiredAt DateTime @default(now())
}

model Customer {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Role {
  id          String        @id @default(uuid())
  name        String        @unique   
  description String?
  appliesTo   ProfileKind?
  features    RoleFeature[]
  users       UserRole[]
}


model Feature {
  id          String        @id @default(uuid())
  name        String        @unique   
  description String?
  roles       RoleFeature[]
  users       UserFeature[]
}

model RoleFeature {
  roleId    String
  featureId String
  role      Role    @relation(fields: [roleId], references: [id], onDelete: Cascade)
  feature   Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)
  @@id([roleId, featureId])
}

model UserRole {
  userId String
  roleId String
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role @relation(fields: [roleId], references: [id], onDelete: Cascade)
  @@id([userId, roleId])
}

model UserFeature {
  userId    String
  featureId String
  granted   Boolean @default(true)   // true = concede · false = nega
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  feature   Feature @relation(fields: [featureId], references: [id], onDelete: Cascade)
  @@id([userId, featureId])
}

enum ProfileKind {
  EMPLOYEE
  CUSTOMER
}