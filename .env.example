# .env.example — template versionado. Copie para o arquivo do ambiente:
#   dev   → .env.development   (host tooling: prisma authoring)
#   test  → .env.test          (runner do Vitest no host)
#   prod  → .env.production     (fora do git; preencha os segredos reais)
#
# Os CONTAINERS recebem estas variáveis via `env_file:` do docker-compose.
# O tooling do HOST (prisma, vitest) recebe via dotenv-cli / vitest.config.

# App
# Porta que o Node escuta DENTRO do container. Em produção ela é **contrato**, não
# preferência: o compose só a `expose:` e o reverse proxy faz
# `proxy_pass http://pet-oasis-api:3000`. Mudar isto aqui sem mudar os dois sobe
# um container verde que o proxy não alcança — site em 502 com healthcheck feliz.
PORT=3000
# Porta publicada no HOST pelo Compose (`${API_PORT}:3000`) — **só em dev**. Em
# produção a porta não é publicada: o nginx alcança a API por DNS de container na
# rede `proxy`, e é a ausência de publicação que torna seguro o `trust proxy` por
# endereço privado do `app.ts` (10.2). Preencher isto no `.env.production` não
# tem efeito nenhum; republicar a porta no compose de produção reabre o furo.
# Só o lado do host é variável: o lado do container é 3000 fixo no compose, então
# mexer no PORT acima sem mexer no compose publica para uma porta morta. Segue o
# nome do serviço (`api`), não o do processo.
API_PORT=3000
# development | test | production
NODE_ENV=development

# Database
# POSTGRES_* alimentam o serviço `db` do Compose e a derivação da DATABASE_URL
# do container (o override do serviço `api` aponta p/ o serviço `db`: @db:5432).
# DATABASE_URL abaixo é a forma HOST (localhost), usada por prisma/vitest no host.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pet_oasis
POSTGRES_PORT=5432
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pet_oasis"

# Auth — JWT_SECRET e PEPPER precisam ter >=32 chars (obrigatórios, sem default).
# Em produção gere fortes: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=15m
PEPPER=

# Mail
# Dev usa mailpit (o container `api` aponta SMTP_HOST=mailpit internamente).
# Produção usa um relay real (ex. Resend: smtp.resend.com:465 + USER/PASS).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Pet Oasis <no-reply@petoasis.dev>"
# Origem do front-end — o app que a PESSOA vê, usado nos links dos emails.
# Não é o endereço da API: em produção o front atende no apex e a API num
# subdomínio próprio (`api.`), que é o que o UPLOAD_PUBLIC_BASE_URL lá embaixo
# segue. Apontar isto para a API manda quem clica no link de verificação para um
# host que não tem a página — 404 no fluxo que destrava conta nova.
APP_URL=http://localhost:5173

# Demo (usuário público read-only da referência hospedada)
# Ligado em produção/demo; desligado em dev/test.
SEED_DEMO_USER=false
DEMO_EMAIL=demo@petoasis.dev
DEMO_PASSWORD=DemoOasis2026!

# Dataset de usuários fake (customers/employees/híbridos + exemplos de
# ban/pendência/soft delete) — popula dev e o demo público com dado de
# verdade em vez de listas vazias. Desligado em teste (não suja a suíte).
SEED_FAKE_DATA=false
# Senha única compartilhada por todo o dataset fake (não o admin abaixo).
SEED_FAKE_USER_PASSWORD=FakeOasis2026!

# Usuário admin de teste, acesso total (não-readonly). NUNCA true em
# produção/demo — diferente do usuário demo (só leitura), este teria escrita
# irrestrita exposta na internet. Só dev/local.
SEED_ADMIN_USER=false
SEED_ADMIN_EMAIL=admin@petoasis.dev
SEED_ADMIN_PASSWORD=AdminOasis2026!

# Redis (rate limiting e lockout — Fase 7)
# REDIS_PORT alimenta o serviço `redis` do Compose. REDIS_URL abaixo é a forma
# HOST (localhost), usada por tooling/Vitest; o container `api` recebe a forma
# de rede (redis://redis:6379) pelo override do Compose — igual à DATABASE_URL.
# Test usa 6380 (isolado do dev, como o Postgres em 5433).
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Observabilidade
# fatal | error | warn | info | debug | trace | silent
# Os DESTINOS são escolhidos por ambiente (src/lib/logger.ts): prod escreve
# stdout+buffer, dev usa pino-pretty+buffer e test escreve SÓ no ring buffer —
# por isso o .env.test usa `debug` e ainda assim a suíte não polui a saída.
LOG_LEVEL=info
# Tamanho do ring buffer em memória lido por GET /logs/recent.
LOG_BUFFER_SIZE=500

# Bordas HTTP
# A allowlist inteira do CORS, separada por vírgula. Só entra página web que
# chama a API direto do JavaScript, de outra origem. APP_URL NÃO entra por
# inércia: o front usa BFF (quem chama é o servidor dele, sem `Origin`), e app
# mobile nativo não tem navegador nem preflight. Vazia é o normal hoje.
CORS_ALLOWED_ORIGINS=
# Teto do corpo JSON aceito; acima disto a API responde 413.
JSON_BODY_LIMIT=100kb

# Rate limiting (7.9) — janela deslizante por IP e por email-alvo, contada no
# Redis (rate-limiter-flexible). MAX = tentativas permitidas na janela;
# WINDOW_MS = duração da janela em milissegundos. Excedido → 429 genérico.
RATE_LIMIT_LOGIN_MAX=20
RATE_LIMIT_LOGIN_WINDOW_MS=900000
RATE_LIMIT_SIGNUP_MAX=5
RATE_LIMIT_SIGNUP_WINDOW_MS=3600000
# Compartilhado entre forgot-password e verify-email/resend, por IP.
RATE_LIMIT_EMAIL_MAX=5
RATE_LIMIT_EMAIL_WINDOW_MS=3600000
# Mesmas duas rotas, mas contado pelo email-alvo (não o IP) — fecha o furo do
# atacante que rotaciona IP para bombardear a caixa de uma vítima específica.
RATE_LIMIT_EMAIL_TARGET_MAX=5
RATE_LIMIT_EMAIL_TARGET_WINDOW_MS=3600000
# Rotas públicas que consomem token opaco (reset-password,
# confirm-email-change, confirm-account-reactivation), por IP — 8.7.
RATE_LIMIT_TOKEN_MAX=20
RATE_LIMIT_TOKEN_WINDOW_MS=900000
# Leitura pública do catálogo (breeds, brands, categories, tags), por IP — 9.6.
# Teto folgado: navegar a vitrine são muitos GETs legítimos em sequência.
RATE_LIMIT_CATALOG_MAX=300
RATE_LIMIT_CATALOG_WINDOW_MS=900000

# Upload de imagem (9.10), contado por USUÁRIO e não por IP — vários
# funcionários cadastrando o catálogo saem pelo mesmo NAT, e contar por IP
# quebraria justamente o mutirão de implantação. 150/15min é ~1 imagem a cada
# 6 segundos sustentados, muito acima do ritmo de escolher e conferir foto.
RATE_LIMIT_UPLOAD_MAX=150
RATE_LIMIT_UPLOAD_WINDOW_MS=900000

# Account lockout (7.10) — janela fixa inicial, dobrando a cada ciclo até o
# teto, se a tentativa seguinte à expiração da janela também errar. Contador
# vive no Redis (src/lib/lockout.ts), sem coluna nova no User. A conta com a
# role `demo` é isenta (8.8) — senha pública, o lockout ali só abriria DoS.
LOCKOUT_THRESHOLD=5
LOCKOUT_WINDOW_MS=900000
LOCKOUT_MAX_MS=86400000

# Destinos externos (7.11) — ambos opcionais; ausentes, a app degrada para
# stdout+ring buffer (Axiom) / não captura exceções (Sentry), sem afetar o
# boot. Ver docs/fase-7-f-external-setup.md (temporário) para criar as contas.
AXIOM_TOKEN=
AXIOM_DATASET=
SENTRY_DSN=

# Timeouts (7.12) — sem eles, uma dependência pendurada trava o request pelo
# timeout de socket do SO em vez de falhar rápido.
SERVER_HEADERS_TIMEOUT_MS=65000
SERVER_REQUEST_TIMEOUT_MS=70000
SERVER_KEEP_ALIVE_TIMEOUT_MS=61000
PRISMA_TX_MAX_WAIT_MS=5000
PRISMA_TX_TIMEOUT_MS=8000
# Timeout de aquisição de conexão do pool do driver (`pg`/adapter-pg) — não é
# o `pool_timeout` de query string do Prisma clássico (não se aplica aqui).
DB_POOL_CONNECT_TIMEOUT_MS=5000
REDIS_CONNECT_TIMEOUT_MS=2000
REDIS_COMMAND_TIMEOUT_MS=2000
SMTP_CONNECTION_TIMEOUT_MS=10000
SMTP_GREETING_TIMEOUT_MS=5000
SMTP_SOCKET_TIMEOUT_MS=20000

# Manutenção e faxina (7.13/7.14) — scripts em src/scripts/, agendados por
# systemd timer (infra/cron/), nunca dentro do ciclo request/response.
# Teto de sessões vivas por usuário; login nunca é recusado (evict da mais
# antiga ao exceder).
MAX_LIVE_SESSIONS=5
# Dias após a "morte" (expirou, foi usada ou invalidada) até o hard delete de
# Session/VerificationToken via cleanup-sessions.
SESSION_RETENTION_DAYS=30
# Dias até o hard delete de AuditLog via cleanup-audit-log — único ponto do
# código autorizado a apagar audit log. Default conservador (produção); o
# deploy demo usa 21.
AUDIT_LOG_RETENTION_DAYS=365
# Upload de imagem (9.10) — diretório de destino, base pública das URLs e teto
# por arquivo. O diretório é BIND MOUNT no Compose (não volume nomeado): é o que
# permite, no dia em que houver tráfego, trocar o `express.static` do Node por um
# `location /uploads/ { alias ...; }` no nginx sem tocar em código nem no banco
# (o banco guarda a chave, nunca a URL completa).
# O que é regra de domínio — 8 imagens por produto, dimensões por dono, formatos
# aceitos — é constante em src/lib/storage/, não env var.
UPLOAD_DIR=./uploads
# Só produção, e obrigatória lá: caminho absoluto NO HOST que o Compose monta
# em /app/uploads — o `prod:up` falha nomeando a variável se ela faltar. Precisa
# ficar FORA do working tree do repo clonado: lá dentro o git e o container
# escrevem com uids diferentes e não há dono que sirva aos dois (o `chown` está
# em docs/guides/deploy.md). É também o diretório que o nginx do servidor pode
# passar a servir direto amanhã.
UPLOAD_HOST_DIR=/srv/pet-oasis-data/uploads
# A base pública das URLs de imagem. Em produção é o **host da API**
# (`https://pet-oasis-api.maiahub.com.br/uploads`), não o do front: quem serve o
# byte é a API, e é o subdomínio que tem o certificado dela. Trocar de host é só
# trocar isto — o banco guarda a **chave** do arquivo, nunca a URL, então não há
# migration nem linha a reescrever (ADR file-storage-and-uploads.md).
UPLOAD_PUBLIC_BASE_URL=http://localhost:3000/uploads
UPLOAD_MAX_FILE_SIZE_BYTES=5242880
# Idade mínima para um arquivo sem linha ser considerado órfão pela varredura
# (npm run db:cleanup-uploads). A ordem de escrita é disco → linha, então
# arquivo recém-gravado pode ser um upload em voo: apagá-lo sumiria com a
# imagem de alguém no meio do request.
UPLOAD_ORPHAN_GRACE_HOURS=24

# Guarda explícita do demo-reset.ts (truncate + reseed) — NUNCA inferida de
# NODE_ENV. Só true no .env.production de um deploy demo de verdade.
DEMO_MODE=false
