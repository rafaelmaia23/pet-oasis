meta {
  name: Get Me
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/me
  body: none
  auth: inherit
}

script:post-response {
  if (res.getStatus() === 200) {
    bru.setVar("userId", res.getBody().id);
    // A coleção de pets é aninhada em /customers/:customerId, e é daqui que
    // sai o id do perfil de cliente — não existe /me/pets nesta fase.
    if (res.getBody().customer) {
      bru.setVar("customerId", res.getBody().customer.id);
    }
  }
}
