# .env.example — template versionado. Copie para o arquivo do ambiente:
#   dev   → .env.development   (host tooling: prisma authoring)
#   test  → .env.test          (runner do Vitest no host)
#   prod  → .env.production     (fora do git; preencha os segredos reais)
#
# Os CONTAINERS recebem estas variáveis via `env_file:` do docker-compose.
# O tooling do HOST (prisma, vitest) recebe via dotenv-cli / vitest.config.

# App
PORT=3000
# development | test | production
NODE_ENV=development

# Database
# POSTGRES_* alimentam o serviço `db` do Compose e a derivação da DATABASE_URL
# do container (o app override aponta p/ o serviço `db`: @db:5432).
# DATABASE_URL abaixo é a forma HOST (localhost), usada por prisma/vitest no host.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pet_oasis
POSTGRES_PORT=5432
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pet_oasis"

# Auth — JWT_SECRET e PEPPER precisam ter >=32 chars (obrigatórios, sem default).
# Em produção gere fortes: openssl rand -hex 32
JWT_SECRET=
JWT_EXPIRES_IN=15m
PEPPER=

# Mail
# Dev usa mailpit (o container do app aponta SMTP_HOST=mailpit internamente).
# Produção usa um relay real (ex. Resend: smtp.resend.com:465 + USER/PASS).
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Pet Oasis <no-reply@petoasis.dev>"
# Origem do front-end; em produção use o domínio real.
APP_URL=http://localhost:5173

# Demo (usuário público read-only da referência hospedada)
# Ligado em produção/demo; desligado em dev/test.
SEED_DEMO_USER=false
DEMO_EMAIL=demo@petoasis.dev
DEMO_PASSWORD=DemoOasis2026!

# Redis (rate limiting e lockout — Fase 7)
# REDIS_PORT alimenta o serviço `redis` do Compose. REDIS_URL abaixo é a forma
# HOST (localhost), usada por tooling/Vitest; o container do app recebe a forma
# de rede (redis://redis:6379) pelo override do Compose — igual à DATABASE_URL.
# Test usa 6380 (isolado do dev, como o Postgres em 5433).
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# Observabilidade
# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info
# Tamanho do ring buffer em memória lido por GET /logs/recent.
LOG_BUFFER_SIZE=500

# Bordas HTTP
# Origens extras liberadas no CORS além do APP_URL, separadas por vírgula.
CORS_ALLOWED_ORIGINS=
# Teto do corpo JSON aceito; acima disto a API responde 413.
JSON_BODY_LIMIT=100kb
