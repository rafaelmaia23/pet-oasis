meta {
  name: Remove Feature Override
  type: http
  seq: 7
}

delete {
  url: {{baseUrl}}/users/{{userId}}/roles/{{roleId}}/features/{{featureId}}
  body: none
  auth: inherit
}

docs {
  Exige manage:permission (o demo não tem → 403). featureId vem de "List Features";
  roleId vem de "List User Roles". Sem override ativo da tripla (user, role, feature)
  a resposta é 404 — não revela se o usuário tem aquela role.
}
