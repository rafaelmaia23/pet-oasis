# Copie para .env.production (produção) — o desenvolvimento roda no host e não
# precisa de nenhuma destas por enquanto.
#
# Cada fatia acrescenta o que ela usa: o endereço interno da API, o segredo do
# cookie de sessão e afins nascem nos tickets que os introduzem.

# ─── Compose de produção ──────────────────────────────────────────────────────
# Porta publicada no host pelo container do front.
WEB_PORT=3001

# Network Docker da API, ao qual o front se junta (ADR-0004). É o network default
# do projeto compose de produção da API — mude só se aquele projeto mudar de nome.
API_NETWORK=pet-oasis-prod_default
