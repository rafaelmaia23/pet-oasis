# App
PORT=3000
NODE_ENV=development

# Database
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=pet_oasis
POSTGRES_PORT=5432
# Host tooling (npm run dev, db:migrate) uses localhost. The containerized app
# (docker compose --profile full) derives its own DATABASE_URL pointing at the
# `db` service — see docker-compose.yml; no need to change this line for Docker.
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:${POSTGRES_PORT}/${POSTGRES_DB}"

# Auth — JWT_SECRET and PEPPER must each be at least 32 chars (required, no default)
JWT_SECRET=
JWT_EXPIRES_IN=15m
PEPPER=

# Mail
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Pet Oasis <no-reply@petoasis.dev>"
# Front-end origin; set to the real domain in production.
APP_URL=http://localhost:5173

# Demo (usuário público read-only da referência hospedada)
SEED_DEMO_USER=false
DEMO_EMAIL=demo@petoasis.dev
DEMO_PASSWORD=DemoOasis2026!
