meta {
  name: Upsert Feature Override
  type: http
  seq: 6
}

put {
  url: {{baseUrl}}/users/{{userId}}/roles/{{roleId}}/features/{{featureId}}
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "granted": true
  }
}

docs {
  Exige manage:permission (o demo não tem → 403). featureId vem de "List Features";
  roleId vem de "List User Roles" — o override pertence à atribuição de role, e sem
  ela ativa a resposta é 422 em roleId.
}
