{
  // Pipeline do workspace. Cada task abaixo é o script de mesmo nome em cada
  // pacote que o tiver; `^x` = "antes, a task x nas dependências do pacote".
  // O `^` faz mais do que ordenar: cria um nó por dependência (mesmo sem o
  // script — fica `<NONEXISTENT>`) cujo hash cobre os arquivos dela, e é assim
  // que mudar um preset em `packages/` invalida a task de quem o consome. Sem
  // ele, o hash de uma task só vê os arquivos do próprio pacote, e trocar a
  // base do Biome devolvia `lint` verde do cache (provado na 11.4).
  //
  // Nenhuma task cacheada lê variável de ambiente — typecheck, lint e build só
  // leem arquivos —, então não há `env`/`globalEnv` a declarar.
  // Quem lê ambiente é `test` (`.env.test`, via dotenv) e `dev`, e os dois não
  // cacheiam. Um `env` aqui só faz sentido quando uma task cacheada passar a
  // depender de ambiente.
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      // `^build`, e não `^typecheck`: quem consome o `dist` de outro pacote
      // precisa dele construído antes de checar tipos. Hoje nenhuma
      // dependência tem build; quando o contrato tiver, a ordem já está aqui.
      // `//#typecheck:root` é a task de raiz que cobre `tools/` (o script que
      // não pertence a pacote nenhum): pendurada aqui, roda em todo
      // `pnpm typecheck`, com o cache dela próprio.
      "dependsOn": ["^build", "//#typecheck:root"]
    },
    "lint": {
      // Os pacotes de config lintam a si mesmos antes de quem os estende, e
      // o hash deles entra no de quem os estende (ver o cabeçalho). A task de
      // raiz linta `tools/` pelo mesmo motivo da de typecheck.
      "dependsOn": ["^lint", "//#lint:root"]
    },
    // Tasks de raiz (`//#`): scripts do package.json da raiz. Só `tools/` e a
    // config que o checa entram no hash de cada uma (`inputs`), senão qualquer
    // arquivo da raiz — o lockfile, um README — invalidaria o cache. Os presets
    // de `packages/` entram pelo mesmo motivo do `^` no cabeçalho: preset fora
    // do hash é cache verde depois de a régua mudar.
    "//#typecheck:root": {
      "inputs": ["tools/**", "tsconfig.json", "packages/tsconfig/tsconfig.*.json"]
    },
    "//#lint:root": {
      "inputs": ["tools/**", "biome.json", "packages/biome-config/biome.json"]
    },
    // `docs:check` não é task do Turbo: é um script da raiz que varre o repo
    // inteiro de uma vez (a documentação de um app cita a do outro, e o
    // recorte por pacote esconderia isso). Roda com `pnpm docs:check`.
    "test": {
      // Sobe Postgres e Redis via Compose e lê `.env.test`: cachear exigiria
      // declarar esses inputs, e o risco é um verde de outro ambiente.
      "cache": false
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
